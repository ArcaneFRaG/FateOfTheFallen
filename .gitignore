/Unity/**/[Ll]ibrary/
/Unity/**/[Tt]emp/
/Unity/**/[Oo]bj/
/Unity/**/[Bb]uild/
/Unity/**/[Bb]uilds/
/Unity/**/[Ll]ogs/
/Unity/**/[Uu]ser[Ss]ettings/
/Unity/**/[Mm]emoryCaptures/
/Unity/**/[Rr]ecordings/
/Unity/**/ExportedObj/
/Unity/**/.gradle/
/Unity/**/.vs/
/Unity/**/.idea/

# Asset Store tooling
/Unity/**/[Aa]ssets/AssetStoreTools*

# Unity-generated IDE files
/Unity/**/*.csproj
/Unity/**/*.sln
/Unity/**/*.suo
/Unity/**/*.user
/Unity/**/*.userprefs
/Unity/**/*.unityproj
/Unity/**/*.booproj
/Unity/**/*.pidb
/Unity/**/*.svd
/Unity/**/*.pdb
/Unity/**/*.mdb
/Unity/**/*.opendb
/Unity/**/*.VC.db

# Unity-generated crash/debug files
/Unity/**/sysinfo.txt
/Unity/**/crashlytics-build.properties

# Unity package exports
/Unity/**/*.unitypackage

# Platform build products
/Unity/**/*.apk
/Unity/**/*.aab
/Unity/**/*.app============================================================

/Assets/Bundles/*.manifest


