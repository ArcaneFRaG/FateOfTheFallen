# ============================================================
# TOPOLOGY DATA
# ============================================================

def get_world_mesh_data(obj):

    matrix = obj.matrix_world
    normal_matrix = obj.matrix_world.to_3x3()

    positions = [
        matrix @ vert.co
        for vert in obj.data.vertices
    ]

    normals = []

    for vert in obj.data.vertices:

        n = normal_matrix @ vert.normal

        if n.length < 0.001:
            n = Vector((0, 1, 0))

        else:
            n.normalize()

        normals.append(n)

    adjacency = [
        []
        for _ in obj.data.vertices
    ]

    for edge in obj.data.edges:

        a = edge.vertices[0]
        b = edge.vertices[1]

        distance = (
            positions[a] -
            positions[b]
        ).length

        adjacency[a].append(
            (
                b,
                distance
            )
        )

        adjacency[b].append(
            (
                a,
                distance
            )
        )

    return (
        positions,
        normals,
        adjacency
    )


# ============================================================
# VERTEX SEARCH
# ============================================================

def nearest_vertex_index(
    positions,
    target
):
    target = Vector(target)

    best_index = 0
    best_distance = float("inf")

    for i, position in enumerate(positions):

        distance = (
            position -
            target
        ).length_squared

        if distance < best_distance:

            best_distance = distance
            best_index = i

    return best_index


def nearest_vertex_index_biased(
    positions,
    normals,
    target,
    desired_normal,
    normal_bias=1.5
):
    target = Vector(target)
    desired = Vector(desired_normal).normalized()

    best_index = 0
    best_score = float("inf")

    for i, position in enumerate(positions):

        distance = (
            position -
            target
        ).length_squared

        alignment = normals[i].dot(
            desired
        )

        normal_penalty = (
            1.0 -
            alignment
        ) * normal_bias

        score = (
            distance +
            normal_penalty
        )

        if score < best_score:

            best_score = score
            best_index = i

    return best_index


# ============================================================
# DIJKSTRA EDGE PATH
# ============================================================

def shortest_mesh_edge_path(
    positions,
    adjacency,
    start_index,
    end_index,
    normals=None,
    desired_normal=None,
    surface_bias=0.0
):
    if start_index == end_index:
        return [start_index]

    desired = None

    if desired_normal is not None:
        desired = Vector(desired_normal).normalized()

    distances = {
        start_index: 0.0
    }

    previous = {}

    heap = [
        (
            0.0,
            start_index
        )
    ]

    visited = set()

    while heap:

        current_distance, current = heapq.heappop(heap)

        if current in visited:
            continue

        visited.add(current)

        if current == end_index:
            break

        for neighbour, edge_distance in adjacency[current]:

            cost = edge_distance

            if (
                desired is not None
                and
                normals is not None
                and
                surface_bias > 0.0
            ):

                average_normal = (
                    normals[current] +
                    normals[neighbour]
                )

                if average_normal.length > 0.001:

                    average_normal.normalize()

                    alignment = average_normal.dot(
                        desired
                    )

                    penalty = (
                        1.0 -
                        alignment
                    ) * surface_bias

                    cost *= (
                        1.0 +
                        max(
                            0.0,
                            penalty
                        )
                    )

            new_distance = (
                current_distance +
                cost
            )

            if (
                neighbour not in distances
                or
                new_distance < distances[neighbour]
            ):

                distances[neighbour] = new_distance
                previous[neighbour] = current

                heapq.heappush(
                    heap,
                    (
                        new_distance,
                        neighbour
                    )
                )

    if end_index not in distances:

        return [
            start_index,
            end_index
        ]

    path = [
        end_index
    ]

    current = end_index

    while current != start_index:

        current = previous[current]
        path.append(current)

    path.reverse()

    return path


# ============================================================
# WAYPOINT TARGET GENERATION
# ============================================================

def build_waypoint_targets(
    start,
    end,
    radius_side_start,
    radius_front_start,
    radius_side_end,
    radius_front_end,
    angles_deg
):
    start = Vector(start)
    end = Vector(end)

    axis = end - start
    axis.normalize()

    world_front = Vector((0, 1, 0))

    front = (
        world_front -
        axis *
        world_front.dot(axis)
    )

    if front.length < 0.001:
        front = Vector((1, 0, 0))

    front.normalize()

    side = axis.cross(front)
    side.normalize()

    targets = []

    count = len(angles_deg)

    for i, angle_deg in enumerate(angles_deg):

        t = (
            i /
            max(
                1,
                count - 1
            )
        )

        center = start.lerp(
            end,
            t
        )

        radius_side = lerp(
            radius_side_start,
            radius_side_end,
            t
        )

        radius_front = lerp(
            radius_front_start,
            radius_front_end,
            t
        )

        angle = math.radians(
            angle_deg
        )

        radial = (
            side *
            math.sin(angle) *
            radius_side
            +
            front *
            math.cos(angle) *
            radius_front
        )

        targets.append(
            center +
            radial
        )

    return targets


# ============================================================
# NORMAL TOPOLOGY PATH
# ============================================================

def build_topology_path(
    obj,
    waypoint_targets
):
    (
        positions,
        normals,
        adjacency
    ) = get_world_mesh_data(obj)

    waypoint_indices = []

    for target in waypoint_targets:

        index = nearest_vertex_index(
            positions,
            target
        )

        if (
            len(waypoint_indices) == 0
            or
            waypoint_indices[-1] != index
        ):
            waypoint_indices.append(index)

    if len(waypoint_indices) < 2:
        return [], []

    final_indices = []

    for i in range(
        len(waypoint_indices) - 1
    ):

        section = shortest_mesh_edge_path(
            positions,
            adjacency,
            waypoint_indices[i],
            waypoint_indices[i + 1]
        )

        if final_indices:
            section = section[1:]

        final_indices.extend(section)

    cleaned = []

    for index in final_indices:

        if (
            len(cleaned) == 0
            or
            cleaned[-1] != index
        ):
            cleaned.append(index)

    points = [
        positions[index]
        for index in cleaned
    ]

    path_normals = [
        normals[index]
        for index in cleaned
    ]

    return (
        points,
        path_normals
    )


# ============================================================
# BACK-BIASED TOPOLOGY PATH
# ============================================================

def build_back_topology_path(
    obj,
    target_points
):
    (
        positions,
        normals,
        adjacency
    ) = get_world_mesh_data(obj)

    back = Vector(
        (0, -1, 0)
    )

    waypoint_indices = []

    for target in target_points:

        index = nearest_vertex_index_biased(
            positions,
            normals,
            target,
            back,
            normal_bias=2.0
        )

        if (
            len(waypoint_indices) == 0
            or
            waypoint_indices[-1] != index
        ):
            waypoint_indices.append(index)

    if len(waypoint_indices) < 2:
        return [], []

    final_indices = []

    for i in range(
        len(waypoint_indices) - 1
    ):

        section = shortest_mesh_edge_path(
            positions,
            adjacency,
            waypoint_indices[i],
            waypoint_indices[i + 1],
            normals=normals,
            desired_normal=back,
            surface_bias=3.5
        )

        if final_indices:
            section = section[1:]

        final_indices.extend(section)

    cleaned = []

    for index in final_indices:

        if (
            len(cleaned) == 0
            or
            cleaned[-1] != index
        ):
            cleaned.append(index)

    points = [
        positions[index]
        for index in cleaned
    ]

    path_normals = [
        normals[index]
        for index in cleaned
    ]

    return (
        points,
        path_normals
    )


# ============================================================
# EDGE RIBBON
# ============================================================

def make_edge_ribbon(
    name,
    points,
    normals,
    width,
    material,
    lift
):
    if len(points) < 2:
        return None

    verts = []
    faces = []

    for i, point in enumerate(points):

        p = Vector(point)
        normal = Vector(normals[i]).normalized()

        if i == 0:

            tangent = (
                Vector(points[1]) -
                p
            )

        elif i == len(points) - 1:

            tangent = (
                p -
                Vector(points[i - 1])
            )

        else:

            tangent = (
                Vector(points[i + 1]) -
                Vector(points[i - 1])
            )

        if tangent.length < 0.001:
            tangent = Vector((0, 0, 1))

        else:
            tangent.normalize()

        sideways = normal.cross(tangent)

        if sideways.length < 0.001:
            sideways = Vector((1, 0, 0))

        else:
            sideways.normalize()

        center = (
            p +
            normal * lift
        )

        half = width * 0.5

        verts.append(
            tuple(
                center +
                sideways *
                half
            )
        )

        verts.append(
            tuple(
                center -
                sideways *
                half
            )
        )

    for i in range(
        len(points) - 1
    ):

        a = i * 2
        b = (i + 1) * 2

        faces.append(
            (
                a,
                a + 1,
                b
            )
        )

        faces.append(
            (
                a + 1,
                b + 1,
                b
            )
        )

    mesh = bpy.data.meshes.new(
        name + "_Mesh"
    )

    mesh.from_pydata(
        verts,
        [],
        faces
    )

    mesh.update()

    obj = bpy.data.objects.new(
        name,
        mesh
    )

    COLL.objects.link(obj)

    flat_shade(obj)
    add_mat(obj, material)

    return obj


