# ============================================================
# RESOLVE OBJECT BONE
# ============================================================

def resolve_bone_for_object(obj):

    name = obj.name

    if name in EXACT_BONE_BINDINGS:

        return EXACT_BONE_BINDINGS[
            name
        ]

    if name in MOSS_BONE_BINDINGS:

        return MOSS_BONE_BINDINGS[
            name
        ]

    for prefix, bone_name in PREFIX_BONE_BINDINGS:

        if name.startswith(
            prefix
        ):
            return bone_name

    return None


# ============================================================
# APPLY RIG
# ============================================================

rigged_count = 0
unassigned = []

for obj in list(COLL.objects):

    if obj == armature:
        continue

    if obj.name == "Ground_Reference":
        continue

    if obj.type != 'MESH':
        continue

    bone_name = resolve_bone_for_object(
        obj
    )

    if bone_name is None:

        unassigned.append(
            obj.name
        )

        continue

    rigid_bind(
        obj,
        bone_name
    )

    rigged_count += 1


