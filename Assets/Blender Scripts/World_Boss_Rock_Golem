def make_rock(
    name,
    location,
    scale,
    rotation=(0, 0, 0),
    distortion=0.15,
    seed_offset=0,
    dark_bias=False,
    material_override=None
):
    bpy.ops.mesh.primitive_ico_sphere_add(
        subdivisions=1,
        radius=1.0,
        location=location,
        rotation=rotation
    )

    obj = bpy.context.active_object
    obj.name = name

    move_to_collection(obj)

    rng = random.Random(SEED + seed_offset)

    for vert in obj.data.vertices:
        vert.co *= 1.0 + rng.uniform(-distortion, distortion)

    obj.scale = scale

    bpy.context.view_layer.objects.active = obj

    bpy.ops.object.transform_apply(
        location=False,
        rotation=False,
        scale=True
    )

    flat_shade(obj)

    if material_override:
        add_mat(obj, material_override)

    else:
        apply_stone_palette(
            obj,
            seed_offset,
            dark_bias
        )

    return obj


def make_sharp_rock(
    name,
    location,
    scale,
    rotation=(0, 0, 0),
    direction="UP",
    seed_offset=0,
    dark_bias=False,
    material_override=None
):
    obj = make_rock(
        name,
        location,
        scale,
        rotation,
        distortion=0.18,
        seed_offset=seed_offset,
        dark_bias=dark_bias,
        material_override=material_override
    )

    if direction == "UP":

        limit = max(v.co.z for v in obj.data.vertices)

        for v in obj.data.vertices:
            if v.co.z > limit * 0.40:
                v.co.z *= 1.24

    elif direction == "FORWARD":

        limit = max(v.co.y for v in obj.data.vertices)

        for v in obj.data.vertices:
            if v.co.y > limit * 0.40:
                v.co.y *= 1.25

    elif direction == "OUT_POS_X":

        limit = max(v.co.x for v in obj.data.vertices)

        for v in obj.data.vertices:
            if v.co.x > limit * 0.40:
                v.co.x *= 1.20

    elif direction == "OUT_NEG_X":

        limit = min(v.co.x for v in obj.data.vertices)

        for v in obj.data.vertices:
            if v.co.x < limit * 0.40:
                v.co.x *= 1.20

    obj.data.update()

    return obj


# ============================================================
# LOWER LEG
# ============================================================

def make_leg_pillar(
    name,
    x,
    y,
    height,
    base_radius,
    upper_radius,
    seed_offset
):
    rng = random.Random(SEED + seed_offset)

    sides = 7

    rings = [
        (GROUND_Z, base_radius),
        (height * 0.28, base_radius * 0.90),
        (height * 0.62, upper_radius * 1.06),
        (height, upper_radius),
    ]

    verts = []
    faces = []

    for ring_index, (z, radius) in enumerate(rings):

        phase = 0.09 * ring_index

        for i in range(sides):

            angle = math.tau * i / sides + phase

            irregular = rng.uniform(
                0.91,
                1.11
            )

            vx = (
                x +
                math.cos(angle) *
                radius *
                irregular
            )

            vy = (
                y +
                math.sin(angle) *
                radius *
                irregular
            )

            if ring_index == 0:
                vz = GROUND_Z

            else:
                vz = (
                    z +
                    rng.uniform(
                        -0.045,
                        0.045
                    )
                )

            verts.append(
                (
                    vx,
                    vy,
                    vz
                )
            )

    for ring in range(len(rings) - 1):

        a = ring * sides
        b = (ring + 1) * sides

        for i in range(sides):

            ni = (i + 1) % sides

            faces.append(
                (
                    a + i,
                    a + ni,
                    b + ni
                )
            )

            faces.append(
                (
                    a + i,
                    b + ni,
                    b + i
                )
            )

    base_center = len(verts)

    verts.append(
        (
            x,
            y,
            GROUND_Z
        )
    )

    for i in range(sides):

        ni = (i + 1) % sides

        faces.append(
            (
                base_center,
                ni,
                i
            )
        )

    mesh = bpy.data.meshes.new(
        name + "_Mesh"
    )

    mesh.from_pydata(
        verts,
        [],
        faces
    )

    mesh.update()

    obj = bpy.data.objects.new(
        name,
        mesh
    )

    COLL.objects.link(obj)

    flat_shade(obj)

    apply_stone_palette(
        obj,
        seed_offset
    )

    return obj


# ============================================================
# ROOT
# ============================================================

def make_root(
    name,
    points,
    radii,
    material=MAT_ROOT
):
    sides = 5

    pts = [
        Vector(p)
        for p in points
    ]

    verts = []
    faces = []

    for i, p in enumerate(pts):

        if i == 0:
            tangent = pts[1] - pts[0]

        elif i == len(pts) - 1:
            tangent = pts[-1] - pts[-2]

        else:
            tangent = pts[i + 1] - pts[i - 1]

        tangent.normalize()

        ref = Vector((0, 1, 0))

        if abs(tangent.dot(ref)) > 0.9:
            ref = Vector((1, 0, 0))

        axis_a = tangent.cross(ref).normalized()
        axis_b = tangent.cross(axis_a).normalized()

        radius = radii[i]

        for j in range(sides):

            angle = math.tau * j / sides

            offset = (
                axis_a * math.cos(angle) * radius +
                axis_b * math.sin(angle) * radius
            )

            verts.append(
                tuple(
                    p + offset
                )
            )

    for ring in range(len(pts) - 1):

        a = ring * sides
        b = (ring + 1) * sides

        for j in range(sides):

            nj = (j + 1) % sides

            faces.append(
                (
                    a + j,
                    a + nj,
                    b + nj
                )
            )

            faces.append(
                (
                    a + j,
                    b + nj,
                    b + j
                )
            )

    mesh = bpy.data.meshes.new(
        name + "_Mesh"
    )

    mesh.from_pydata(
        verts,
        [],
        faces
    )

    mesh.update()

    obj = bpy.data.objects.new(
        name,
        mesh
    )

    COLL.objects.link(obj)

    flat_shade(obj)
    add_mat(obj, material)

    return obj


