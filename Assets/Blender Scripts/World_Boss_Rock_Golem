# ============================================================
# GENERAL HELPERS
# ============================================================

def flat_shade(obj):
    if obj.type != "MESH":
        return

    for poly in obj.data.polygons:
        poly.use_smooth = False


def add_mat(obj, mat):
    if mat.name not in [m.name for m in obj.data.materials]:
        obj.data.materials.append(mat)


def apply_stone_palette(
    obj,
    seed_offset=0,
    dark_bias=False
):
    for mat in STONE_PALETTE:
        add_mat(obj, mat)

    rng = random.Random(SEED + seed_offset)

    for poly in obj.data.polygons:

        r = rng.random()

        if dark_bias:

            if r < 0.48:
                poly.material_index = 0

            elif r < 0.90:
                poly.material_index = 1

            else:
                poly.material_index = 2

        else:

            if r < 0.22:
                poly.material_index = 0

            elif r < 0.84:
                poly.material_index = 1

            else:
                poly.material_index = 2


def lerp(a, b, t):
    return a + (b - a) * t


