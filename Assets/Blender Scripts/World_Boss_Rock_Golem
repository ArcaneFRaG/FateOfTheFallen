def make_topology_fissure(
    obj,
    name,
    start,
    end,
    radius_side_start,
    radius_front_start,
    radius_side_end,
    radius_front_end,
    angles_deg,
    glow_material,
    dark_width=0.13,
    glow_width=0.045
):
    targets = build_waypoint_targets(
        start,
        end,
        radius_side_start,
        radius_front_start,
        radius_side_end,
        radius_front_end,
        angles_deg
    )

    points, normals = build_topology_path(
        obj,
        targets
    )

    if len(points) < 2:
        return []

    dark = make_edge_ribbon(
        name + "_Dark",
        points,
        normals,
        dark_width,
        MAT_CRACK,
        lift=0.014
    )

    glow = make_edge_ribbon(
        name + "_Glow",
        points,
        normals,
        glow_width,
        glow_material,
        lift=0.023
    )

    result = []

    if dark:
        result.append(dark)

    if glow:
        result.append(glow)

    return result


def make_back_topology_fissure(
    obj,
    name,
    target_points,
    glow_material,
    dark_width=0.13,
    glow_width=0.045
):
    points, normals = build_back_topology_path(
        obj,
        target_points
    )

    if len(points) < 2:
        return []

    dark = make_edge_ribbon(
        name + "_Dark",
        points,
        normals,
        dark_width,
        MAT_CRACK,
        lift=0.015
    )

    glow = make_edge_ribbon(
        name + "_Glow",
        points,
        normals,
        glow_width,
        glow_material,
        lift=0.025
    )

    result = []

    if dark:
        result.append(dark)

    if glow:
        result.append(glow)

    return result


