def create_bone(
    name,
    head,
    tail,
    parent=None,
    deform=True
):
    bone = armature.data.edit_bones.new(
        name
    )

    bone.head = Vector(head)
    bone.tail = Vector(tail)

    bone.use_deform = deform
    bone.use_connect = False

    if parent:
        bone.parent = armature.data.edit_bones.get(
            parent
        )

    return bone


